/dist/
/.dbx-dev/
.dbx-repository-signing-key.env
.DS_Store
*.log

# Go build output must never be committed: the packager builds the sidecar
# from source, and a stale binary in the repository would silently ship.
/backend/*.exe
/backend/*.exe~
/backend/dbx-workbuddy-connect

# IDE / editor settings are per-developer and per-machine, not part of the
# plugin source.
/.idea/
/.vscode/
*.iml

# Local OS metadata.
Thumbs.db
